### Vocabulary metadata - https://dgarijo.github.io/Widoco/doc/bestPractices/index-en.html

seko: a owl:Ontology , skos:ConceptScheme ;
  rdfs:label "SEKO3 - esityskokoonpano-ontologia"@fi ,
             "SEKO3 - ontologi för uppsättning för framförande"@sv ,
             "SEKO3 - ontology for medium of performance"@en ;
  dc:creator <http://www.wikidata.org/entity/Q95592946> ;       # Jarmo Saarikko
  dct:contributor  <http://www.wikidata.org/entity/Q95592946>,  # Jarmo Saarikko
                   <https://www.wikidata.org/wiki/Q109126095> ; # MUUSA
  dct:mediator <http://www.wikidata.org/entity/Q420747> ;       # Kansalliskirjasto 
  dc:publisher <http://www.wikidata.org/entity/Q420747> ;
  dc:source "SEKO ontology is based on the Finnish monolingual Seko vocabulary"@en ;
  dct:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
  dct:description """
         The Finnish ontology of medium of performance is a trilingual ontology consisting of 
         musical instruments and ensembles. SEKO has been founded on the previous monolingual 
         vocabulary created by the LUUMU and later by the MUUSA expert groups on music metadata.
         The new ontology is aimed for the whole GLAM sector to be used for content description of 
         music related materials. The data is now more structured and mapped with several
         several major sources like Wikidata, LCMPT and MIMO vocabularies.  
         In library systems with MARC21 the terms can be used in fields 382, 511 etc. 
         The labels are expressed mainly in the singular form, except for groups.
         A Finnish translation of the Hornbostel-Sachs classification will be added
         as a secondary grouping and hierarchy for easier browsing and discovery.
         Non-hierarchical groupings such as 'folk instruments' may be added later.
         Spatial information is expressed using mainly the YSO places ontology.
  """ ;
  dc:title "SEKO3 - esityskokoonpano-ontologia"@fi ,
           "SEKO3 - ontologi för uppsättning för framförande"@sv ,
           "SEKO3 - ontology for medium of performance"@en ;
  dc:identifier <http://urn.fi/urn:nbn:fi:au:seko:> ,
                <http://www.wikidata.org/entity/Q106573395> ,
                <http://id.loc.gov/vocabulary/musiccodeschemes/seko> ;
  dct:language <http://id.loc.gov/vocabulary/iso639-1/fi>,
             <http://id.loc.gov/vocabulary/iso639-1/sv>,
             <http://id.loc.gov/vocabulary/iso639-1/en> ;
  dct:subject   <http://www.yso.fi/onto/yso/p1808> ;  # musiikki
  foaf:homepage <https://github.com/NatLibFi/SEKO/> ;
  skos:hasTopConcept seko:MediumOfPerformance ;
  dct:relation  mimo:, lcmpt: ;                
  dct:created "2026-06-23"^^xsd:date  ;
# dct:issued "2026-06-23"^^xsd:date ;
  dct:modified "2026-08-03"^^xsd:date ; 
  owl:versionInfo "0.07" ;
  dct:comment "v0.07 - added Swedish labels. Used id.kb.se/vocab as main source." ;
.
  
### Vocabulary Classes and properties (for Finnish labels) 
### NOTE: Add the Swedish labels, too! 

### LUOKKAMÄÄRITTELYT (CLASSES)

skos:ConceptScheme a owl:Class ;
    rdfs:label "Sanasto / Käsitejärjestelmä"@fi , "Konceptsystem"@sv, "Concept Scheme"@en .

skos:Concept a owl:Class ;
    rdfs:label "Musiikkikäsite"@fi , "Musikkoncept"@sv, "Music related Concept"@en .

skos:Collection a owl:Class ;
    rdfs:label "Kokoelma tai ryhmittely"@fi ,
               "Samling eller gruppning"@sv, 
               "Collection or grouping"@en .

foaf:Agent a rdfs:Class ;
   rdfs:comment "Kuka tahansa osallistuva toimija."@fi, 
                "Vilkenhelst deltagande agent."@sv, 
                "Any type of agent contributing or participating."@en .


### OMINAISUUDET - EGENSKAPER - PROPERTIES 

# The Ontology uses the basic SKOS-properties like: 
# skos:prefLabel, skos:altLabel, skos:hiddenLabel
